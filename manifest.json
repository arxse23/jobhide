{
  "manifest_version": 3,
  "name": "Job Hide",
  "version": "0.1",
  "permissions": ["storage"],
  "content_scripts": [{ 
    "matches": ["*://au.seek.com/*", "*://www.seek.com.au/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
    }],
  "action": { 
    "default_popup": "popup.html"
   }
}