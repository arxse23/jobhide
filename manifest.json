{
  "manifest_version": 3,
  "name": "Seek Job Hide",
  "version": "0.1",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }, 
  "permissions": ["storage"],
  "content_scripts": [{ 
    "matches": ["*://au.seek.com/*", "*://www.seek.com.au/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
    }],
  "action": { 
    "default_popup": "popup.html"
   }
}